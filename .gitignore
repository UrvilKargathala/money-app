# ---- MoneyMind monorepo ----
# Tracks `api/` (backend), `ui/` (frontend), `scripts/` (schema/seed),
# `DOCS/` (documentation) plus workspace manifests. Everything else in the
# working tree is permanently ignored — run `git status` before committing
# to confirm.

# whitelist: ignore everything at the top level, then re-include the backend + frontend
/*
!/api/
!/ui/
!/scripts/
!/DOCS/
!/.githooks/
!/vercel.json
!/pnpm-workspace.yaml
!/package.json
!/pnpm-lock.yaml
!/README.md
!/.gitignore
!/.vercelignore
!/.github/

# --- inside api/ ---
api/node_modules/
api/dist/
api/*.tsbuildinfo
api/.env*

# --- inside ui/ ---
ui/node_modules/
ui/.next/
ui/.next-dev/
ui/out/
ui/dist/
ui/*.tsbuildinfo
ui/.env*.local

# --- scripts/: only the canonical Python sources are tracked ---
scripts/.venv/
scripts/__pycache__/

# --- secrets & local env ---
.env*
.vercel

# --- local attachment storage (LocalFileProvider, dev only) ---
.data/

# --- misc ---
.DS_Store
